{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxlint . && eslint . && oxfmt --check . && vue-tsc --build",
    "generate-pwa-assets": "pwa-assets-generator",
    "gen:api": "openapi-typescript http://localhost:5080/openapi/v1.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dexie": "^4.4.7",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.74.0",
    "oxlint": "~1.89.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
