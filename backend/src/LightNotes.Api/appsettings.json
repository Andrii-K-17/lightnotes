{
  "ConnectionStrings": {
    "Default": "Host=PRODUCTION_HOST;Database=lightnotes_prod;Username=DEPLOY_USER;Password=DEPLOY_PASSWORD"
  },
  "Jwt": {
    "Issuer": "lightnotes",
    "Audience": "lightnotes"
  },
  "Storage": {
    "Path": "../../data/blobs"
  },
  "Ai": {
    "Enabled": true,
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-20b",
    "ReasoningEffort": "low",
    "MaxInputCharacters": 20000,
    "MaxOutputTokens": 4096
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
